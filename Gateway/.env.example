PORT=5180
HOST=0.0.0.0
DATABASE_PATH=./data/gateway.sqlite
JSON_BODY_LIMIT=50mb

# Must match the token generated in Station Admin -> Remote Requests Gateway.
STATION_API_TOKEN=replace-with-station-generated-token

# Comma-separated browser origins. Use * only if this service is public-only
# and all privileged endpoints stay protected by STATION_API_TOKEN.
CORS_ORIGINS=*

PUBLIC_BASE_URL=https://requests.example.com
REQUEST_RETENTION_DAYS=30
